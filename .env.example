NEXT_PUBLIC_API_URL=https://api.example.com
# Never place secrets or signing keys in NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql://nebula:replace_this@localhost:5432/nebula
API_JWT_SECRET=replace_with_64_random_characters_generated_securely
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# Optional. Enables Jamendo results; obtain your own client ID from their developer portal.
JAMENDO_CLIENT_ID=

# Production: do not enable open registration. Owner is initialized by CLI.
API_ALLOW_PUBLIC_REGISTRATION=false
API_COOKIE_SECURE=true
API_COOKIE_SAME_SITE=none
# Initial one-time OWNER setup (temporary secrets; never commit values):
OWNER_EMAIL=
OWNER_PASSWORD=
