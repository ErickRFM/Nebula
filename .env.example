NEXT_PUBLIC_API_URL=https://api.example.com
# Never place secrets or signing keys in NEXT_PUBLIC_* variables.
DATABASE_URL=postgresql://nebula:replace_this@localhost:5432/nebula
API_JWT_SECRET=replace_with_64_random_characters_generated_securely
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# Optional. Enables Jamendo results; obtain your own client ID from their developer portal.
JAMENDO_CLIENT_ID=

# Production: do not enable open registration. Private accounts are provisioned by the owner
# (OWNER via CLI: npm run owner:bootstrap, other accounts via /v1/admin/invites).
NEBULA_ALLOW_REGISTRATION=false

# Owner bootstrap (used by: npm run owner:bootstrap)
NEBULA_OWNER_EMAIL=owner@example.com
NEBULA_OWNER_PASSWORD=replace_with_a_strong_password_min_12_chars

# Session / refresh cookie settings
API_ACCESS_TTL_SECONDS=900
API_REFRESH_TTL_DAYS=30
API_COOKIE_NAME=nebula_refresh
# Set to true only when the web app and API are served from the same site.
# Cross-site deployments (e.g. Vercel web + Render API) require secure SameSite=None cookies.
API_COOKIE_SECURE=false
API_COOKIE_SAME_SITE=lax
# API_COOKIE_DOMAIN=.example.com
