{
  "name": "@nebula/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "db:migrate": "node scripts/migrate.mjs",
    "owner:bootstrap": "node scripts/bootstrap-owner.mjs"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "drizzle-orm": "^0.44.0",
    "pg": "^8.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "@types/pg": "^8.15.0"
  }
}
